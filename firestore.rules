rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/settings/ootss {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasAll(['values', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['values', 'updatedAt'])
        && request.resource.data.values is map
        && request.resource.data.updatedAt is timestamp;
    }

    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /{path=**}/boardMessages/{messageId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 50;
    }

    match /boards/{boardId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 30000;
      allow create, update: if request.auth != null
        && validBoard(boardId)
        && request.resource.data.keys().hasOnly(['kind', 'mapPrefix', 'lastMessageId', 'updatedAt'])
        && request.resource.data.kind == (boardId == 'general' ? 'general' : 'cell')
        && request.resource.data.mapPrefix is string
        && (boardId == 'general'
          ? request.resource.data.mapPrefix == ''
          : boardId.matches('^' + request.resource.data.mapPrefix + '[+-].*')
            && request.resource.data.mapPrefix in ['O', 'OH', 'OL', 'I', 'S', 'M', 'MH', 'ML'])
        && request.resource.data.lastMessageId is string
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/boards/$(boardId)/boardMessages/$(request.resource.data.lastMessageId)).data.authorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/boards/$(boardId)/boardMessages/$(request.resource.data.lastMessageId)).data.createdAt == request.time;

      match /boardMessages/{messageId} {
        allow create: if request.auth != null
          && validBoard(boardId)
          && request.resource.data.keys().hasOnly(['boardId', 'kind', 'authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.boardId == boardId
          && request.resource.data.kind == (boardId == 'general' ? 'general' : 'cell')
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName == request.auth.token.name
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.text.matches('(?s).*\\S.*')
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/boards/$(boardId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/boards/$(boardId)).data.updatedAt == request.time;
      }
    }

    function validBoard(boardId) {
      return boardId == 'general'
        || boardId.matches('^O[HL]?(\\+0[0-4]|-0[1-5])(\\+0[0-6]|-0[1-5])[A-S][A-M]$')
        || boardId.matches('^I(\\+0[0-3]|-0[1-3])\\+(0[0-9]|1[0-4])[A-M][A-G]$')
        || boardId.matches('^S(\\+0[0-8]|-0[1-5])(\\+0[0-2]|-(0[1-9]|1[0-3]))[A-I][A-F]$')
        || boardId.matches('^S(\\+0[0-8]|-0[1-5])\\+03[A-I][A-E]$')
        || boardId.matches('^M[HL]?(\\+0[0-4]|-0[1-5])(\\+0[0-6]|-0[1-5])[A-E][A-C]$');
    }
  }
}
